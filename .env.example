# ==============================================================================
# CampusLink 2.0 — Production & Development Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure appropriate values for your environment.
# NEVER commit your real .env file or production credentials to source control.

# ------------------------------------------------------------------------------
# 1. APPLICATION & RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
# Options: development, testing, production
CAMPUSLINK_ENV=development
PORT=5000

# Strict production security keys (Must be >= 32 characters in production)
CAMPUSLINK_SECRET_KEY=replace_with_a_secure_random_32_plus_char_secret_key
CAMPUSLINK_JWT_SECRET=replace_with_a_secure_random_32_plus_char_jwt_secret
CAMPUSLINK_JWT_EXP_HOURS=24

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (MySQL 8.0+ / SQLite Fallback)
# ------------------------------------------------------------------------------
# In production, USE_MYSQL must be true and MYSQL_PASSWORD must be provided.
USE_MYSQL=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=campus_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DB=campuslink_umat

# ------------------------------------------------------------------------------
# 3. REDIS & DISTRIBUTED STATE
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT_SEC=1.0

# ------------------------------------------------------------------------------
# 4. CELERY BACKGROUND WORKERS & ASYNCHRONOUS TASK QUEUES
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
# Set to false in production (requires active celery worker process)
CELERY_ALWAYS_EAGER=true
CELERY_TASK_TIME_LIMIT_SEC=300

# ------------------------------------------------------------------------------
# 5. MOBILE MONEY & PAYMENT GATEWAY INTEGRATION
# ------------------------------------------------------------------------------
MOMO_WEBHOOK_SECRET=replace_with_your_cryptographic_webhook_hmac_secret
MOMO_GATEWAY_PROVIDER=mock
PAYSTACK_SECRET_KEY=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 6. PLATFORM COMMISSION RATES
# ------------------------------------------------------------------------------
CAMPUSLINK_COMMISSION_RATE=0.10
CAMPUSLINK_SERVICE_COMMISSION_RATE=0.10
